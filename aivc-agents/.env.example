# Copy to .env. Every value here has a working default; the repo runs with none of them set.

# --- provider ---------------------------------------------------------------
# offline = deterministic stub (CI, no network). ollama = LAN host with a real model.
AIVC_PROVIDER=ollama
AIVC_MODEL=auto
AIVC_OLLAMA_BASE_URL=http://192.168.1.177:11434
# Bearer token file (default /tmp/ollama). Override with AIVC_OLLAMA_API_KEY if preferred.
# AIVC_OLLAMA_TOKEN_FILE=/tmp/ollama
# AIVC_OLLAMA_API_KEY=

# CI / no-network fallback:
# AIVC_PROVIDER=offline
# AIVC_MODEL=offline-deterministic-v1

# AIVC_PROVIDER=anthropic
# AIVC_MODEL=<the model id agreed with the client>
# AIVC_ANTHROPIC_API_KEY=
# AIVC_OPENAI_API_KEY=

# --- guardrails -------------------------------------------------------------
# Hard ceilings per run. Exceeding either aborts rather than spending.
AIVC_RUN_COST_BUDGET_USD=0.50
AIVC_RUN_STEP_BUDGET=12
AIVC_TOOL_TIMEOUT_S=30

# Contracted rate card, as JSON: {"model-id": {"input_per_mtok": 3.0, "output_per_mtok": 15.0}}
# Set this before anyone quotes a cost-per-transaction figure.
# AIVC_PRICING_FILE=./deploy/pricing.json

# --- retrieval --------------------------------------------------------------
AIVC_CHUNK_TOKENS=320
AIVC_CHUNK_OVERLAP_TOKENS=60
AIVC_RETRIEVE_K=6
AIVC_MIN_GROUNDEDNESS=0.35
AIVC_MIN_QUESTION_COVERAGE=0.60

# --- observability ----------------------------------------------------------
AIVC_TRACE_CONSOLE=false
AIVC_SERVICE_NAME=aivc-agents
# Point at the client's existing collector rather than standing up a new tool.
# AIVC_OTEL_ENDPOINT=http://localhost:4318/v1/traces
